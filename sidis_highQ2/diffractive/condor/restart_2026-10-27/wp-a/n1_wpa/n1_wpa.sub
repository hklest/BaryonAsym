# WP-A (restart 2026-10-27) n1_wpa submit file. One job per (input, split[, chain]).
# Worker: scripts/restart_2026-10-27/wp-a/n1_wpa.py via n1_wpa_job.sh.
# Submit with the slice queue file and log tag, e.g.
#   condor_submit QFILE=<abs path to queue file> TAG=s1 n1_wpa.sub
# Queue columns: label,kind,input,split,outdir,noise_table,chain,extra,mem,rt,disk
# Resources (1 CPU, pattern condor/t4/localization_diag_2026-10-20): 7091/7094/7096
# 8192 MiB/7200 s/40G; 7071/7097 4096 MiB/2700 s/15G; others 2048 MiB/1800 s/2G.
universe        = vanilla
executable      = /data/dust/group/h1/klesthen/BaryonAsym/sidis_highQ2/diffractive/condor/restart_2026-10-27/wp-a/n1_wpa/n1_wpa_job.sh
arguments       = $(label) $(kind) $(input) $(split) $(outdir) $(noise_table) $(chain) $(extra)
output          = /data/dust/group/h1/klesthen/BaryonAsym/sidis_highQ2/diffractive/condor/restart_2026-10-27/wp-a/n1_wpa/logs/$(TAG)/$(label)_$(split)_$(chain)_$(extra).out
error           = /data/dust/group/h1/klesthen/BaryonAsym/sidis_highQ2/diffractive/condor/restart_2026-10-27/wp-a/n1_wpa/logs/$(TAG)/$(label)_$(split)_$(chain)_$(extra).err
log             = /data/dust/group/h1/klesthen/BaryonAsym/sidis_highQ2/diffractive/condor/restart_2026-10-27/wp-a/n1_wpa/logs/$(TAG)/$(Cluster).log
request_memory  = $(mem)
request_disk    = $(disk)
request_cpus    = 1
should_transfer_files   = IF_NEEDED
when_to_transfer_output = ON_EXIT
+MaxRuntime     = $(rt)
+MyProject      = "h1"
requirements    = (OpSysAndVer == "RedHat9") && (TARGET.Arch == "X86_64")
on_exit_remove  = True
notification    = Never
initialdir      = /data/dust/group/h1/klesthen/BaryonAsym/sidis_highQ2/diffractive
queue label, kind, input, split, outdir, noise_table, chain, extra, mem, rt, disk from $(QFILE)

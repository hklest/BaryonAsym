;This is a file sent to me from Daniel as a pointer to the different MC sets used for his low Q2 jets analysis, I only use this as a reference for existing MC since they are not in the normal MC database

;--------------------------------------------------------------------------------------------------------------------------------
; Very simple example how to send two jobs to the local batch system

[DEFAULT]


[global]
task          = UserTask           ; Job uses user written scripts
backend       = local              ; Send to local batch system
cmdargs       = ;-G -c ;-s         
;workdir base  = /nfs/... ; fred
;workdir       = /nfs/... ;


[storage]
landing zone space used = 5000           ; Maximum amount of space used
scratch space used = 5000               ; Maximum amount of space used


[local]
qsub args     = -m a ;-l h_rt=3:00:00 -l h_vmem=8G -l h_fsize=8G -l arch=amd64 ;-cwd      ; additional arguments directly passed to 'qsub' unparsed when submitting jobs
;sandbox path  = 
;scratch path  =  ; also takes env vars

;wms            = pbs
;scratch path   = /x01/pbs/tmp/${PBS_JOBID}


[jobs] 
wall time     = 3:00               ; Jobs will take max hh[:mm[:ss]]
;max retry     = 2                  ; Number of resubmission attempts for failed jobs - default: no limit
memory        = 4096 ; 2048 ;8192 ; 16384 ; 8192                ; Requested memory in MB - default: 512 ; NAF jobs need 2000 MB !
; jobs           = 20


[constants]
#SYS           = -s JESUp
#SYS           = -g -r -> SYS_LOOKUP

[parameters]                       ; This section defines the parameter space
repeat         = 1                 ; How many times each parameter space point should be sampled


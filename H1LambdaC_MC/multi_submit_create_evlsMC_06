# $(Process) #If you want to send an argument to the executable, here $(Process) is the number of the job, e.g 0-999 for 1000 jobs

#Memory requested in bytes
RequestMemory            = 2048
should_transfer_files    = Yes
getenv                   = True
when_to_transfer_output  = ON_EXIT
requirements             = OpSysAndVer == "CentOS7"
+RequestRuntime          = 86400

#running time requested in seconds, jobs exceeding runtime will be evicted, 
#less runtime requested will get jobs placed on a CPU faster, same with Memory

+MyProject               = "h1"

Queue 52
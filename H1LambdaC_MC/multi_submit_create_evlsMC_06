#An example condor submit script, submitted via "condor_submit submit", won't run out of the box, needs to be modified for your use
#Lambda #Name of executable to be executed, e.g kaonfind_ods, best to specify an absolute path, e.g "nfs/dust/..."

executable = /nfs/dust/h1/group/gtustin/h1oo/bin/x86_64-centos7-gcc9-opt/create_evlsMC       
universe   = vanilla 

#Make sure directory named "log" exists in directory that condor_submit is called from, absolute paths can be specified here if needed
output                   = /nfs/dust/h1/group/gtustin/h1oo/H1LambdaC_MC/log/create_evlsMC_$(Process).out 
error                    = /nfs/dust/h1/group/gtustin/h1oo/H1LambdaC_MC/log/create_evlsMC_$(Process).error 
log                      = /nfs/dust/h1/group/gtustin/h1oo/H1LambdaC_MC/log/create_evlsMC_$(Process).log 


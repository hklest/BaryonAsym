H1SteerOolumi()

    // 2006 e-p and e+p data
fFirstRun   = 444307;
fLastRun    = 492541;

fMinRunLumi = 0.2;
fSubTrigs   = "61";
fPrescaleLimit = 1;

// switch sub detectors on, for a list of all detectors have a
// look at H1SteerOolumi.h
     fCJC1 = 1;
     fCJC2 = 1;
     fLAR = 1;
     fTOF = 1;
     fLUMI = 1;
     fCIP = 1;

     fCaloTrig = 1;

     //fZ0 = 0.0;  //fZ0 = 2.2;
     //fDZ = 30;

     fComptonCorrection = 1;

}


#An example condor submit script, submitted via "condor_submit submit", won't run out of the box, needs to be modified for your use
#Lambda #Name of executable to be executed, e.g kaonfind_ods, best to specify an absolute path, e.g "nfs/dust/..."

executable = /data/dust/group/h1/klesthen/BaryonAsym/bin/x86_64-el9-gcc14-opt/create_evls       
#executable = /usr/bin/singularity
#transfer_executable      = False
universe   = vanilla 

#Make sure directory named "log" exists in directory that condor_submit is called from, absolute paths can be specified here if needed
output                   = /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/log/create_evls_05_$(Process).out 
error                    = /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/log/create_evls_05_$(Process).error 
log                      = /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/log/create_evls_05_$(Process).log 

Arguments = -f /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/Steering/2005/SelectedEvents05_$(Process).steer -o /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/EventLists/2005/condor_05_evls_$(Process).root
             # /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/Steering/2005/SelectedEvents05_$(Process).steer /data/dust/group/h1/klesthen/BaryonAsym/H1LambdaC/EventLists/2005/condor_05_evls $(Process)  

# $(Process) #If you want to send an argument to the executable, here $(Process) is the number of the job, e.g 0-999 for 1000 jobs

#Memory requested in bytes
RequestMemory            = 2048
should_transfer_files    = Yes
getenv                   = True
when_to_transfer_output  = ON_EXIT
#requirements             = OpSysAndVer == "CentOS7"
+RequestRuntime          = 86400

#running time requested in seconds, jobs exceeding runtime will be evicted, 
#less runtime requested will get jobs placed on a CPU faster, same with Memory

+MyProject               = "h1"

Queue 152